# Copy to backend/.env (git-ignored) and fill in as needed. All keys are optional.

# Enables the AI features (T-24/T-25). Leave empty to run without AI.
ANTHROPIC_API_KEY=
# Claude model id used by the AI features (set in T-24).
HAULWISE_AI_MODEL=

# Comma-separated origins allowed to call /api/** (no wildcard).
HAULWISE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OSRM server used only by the explicit distance refresh (T-26).
HAULWISE_OSRM_BASE_URL=https://router.project-osrm.org

# Load demo data on startup.
HAULWISE_SEED_ENABLED=true

# H2 web console at /h2-console (localhost only). Set to false to disable.
HAULWISE_H2_CONSOLE_ENABLED=true
